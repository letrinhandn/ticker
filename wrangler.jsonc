{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ticker",
  "main": "party/server.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PlotRoom",
        "class_name": "PlotRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlotRoom"]
    }
  ]
}
