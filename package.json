{
  "name": "ticker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "party:dev": "wrangler dev --port 8888",
    "dev:all": "concurrently -k -n next,party -c cyan,magenta \"npm run dev\" \"npm run party:dev\"",
    "build": "next build",
    "start": "next start --port 3010",
    "test": "vitest run",
    "lint": "eslint",
    "party:deploy": "wrangler deploy",
    "balance:sim": "npx tsx scripts/balance-sim.ts --sim",
    "balance:catalog": "npx tsx scripts/balance-sim.ts --catalog",
    "balance:tune": "npx tsx scripts/balance-tune.ts",
    "balance:baseline": "npx tsx scripts/balance-tune.ts --baseline",
    "balance:audit": "npx tsx scripts/balance-audit.ts",
    "balance:funds": "npx tsx scripts/fund-matrix.ts",
    "balance:funds:mega": "npx tsx scripts/fund-matrix-parallel.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.160.1"
  }
}
